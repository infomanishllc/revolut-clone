{
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs20.x"
    }
  },
  "routes": [
    { "src": "/api/test", "dest": "/api/test.js" },
    { "src": "/api/auth/login", "dest": "/api/auth/login.js" },
    { "src": "/api/auth/admin-login", "dest": "/api/auth/admin-login.js" },
    { "src": "/api/user/me", "dest": "/api/user/me.js" },
    { "src": "/api/user/fetch-real-profile", "dest": "/api/user/fetch-real-profile.js" },
    { "src": "/api/user/transaction", "dest": "/api/user/transaction.js" },
    { "src": "/api/user/add-money", "dest": "/api/user/add-money.js" },
    { "src": "/api/user/update-profile", "dest": "/api/user/update-profile.js" },
    { "src": "/api/user/chat-message", "dest": "/api/user/chat-message.js" },
    { "src": "/api/live-contacts", "dest": "/api/live-contacts.js" },
    { "src": "/api/admin/users", "dest": "/api/admin/users.js" },
    { "src": "/api/admin/delete-user/(?<id>[^/]+)", "dest": "/api/admin/delete-user.js?id=$id" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
